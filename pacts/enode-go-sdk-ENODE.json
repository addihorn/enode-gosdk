            "$.data[*].createdAt": {
              "format": "yyyy-MM-dd'T'HH:mm:ss'Z'",
              "type": "DateTime"
            }
          }
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
