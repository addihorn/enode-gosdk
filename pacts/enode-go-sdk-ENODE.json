            "Bearer abc123"
          ]
        },
        "matchingRules": {
          "header": {
            "Authorization": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "Bearer .+"
                }
              ]
            }
          }
        },
        "method": "GET",
        "path": "/users"
      },
      "response": {
        "body": {
          "content": {
